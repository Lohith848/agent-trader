# ==============================================================================
# LLM Providers (Configure the ones you wish to use)
# ==============================================================================
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Ollama (Local runtime - keyless).
# Optional: point at a remote Ollama server. Defaults to http://localhost:11434/v1
#OLLAMA_BASE_URL=http://localhost:11434/v1

# ==============================================================================
# Market & Financial Data APIs
# ==============================================================================
# Alpha Vantage (Primary stock market data, OHLCV, indicators, fundamentals, news)
# Free API key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth - optional)
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# ==============================================================================
# Optional Runtime Overrides
# ==============================================================================
#TRADINGAGENTS_LLM_PROVIDER=google
#TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.5-flash
#TRADINGAGENTS_QUICK_THINK_LLM=gemini-3.1-flash-lite
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
#TRADINGAGENTS_TEMPERATURE=0.0
#TRADINGAGENTS_LLM_MAX_RETRIES=3
#TRADINGAGENTS_MAX_TOKENS=8192
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high

